{
  "name": "gcworld/interfaces",
  "description": "GCWorld Interfaces",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "twig/twig": "^3.19"
  },
  "autoload": {
    "psr-4": {
      "GCWorld\\Interfaces\\": "src/"
    }
  },
  "scripts": {
    "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "check": [
      "@lint",
      "@phpstan",
      "@phpcs"
    ]
  },
  "license": "proprietary",
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  }
}
